# ==============================================================================
# EDCIF CKD HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to backend/.env and populate with your own credentials.
# ==============================================================================

# Database Connection URL (SQLite default, or PostgreSQL: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./ckd_project.db

# Cryptographic Key for JWT Authentication Tokens
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Frontend Application URL (used for staff invitation links)
FRONTEND_URL=http://localhost:3000

# Optional SMTP Email Delivery (for sending real invitation emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-hospital-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=care@hospital.org

# ==============================================================================
# APACHE KAFKA CLOUD (Aiven / Self-hosted)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS="kafka-your-host.aivencloud.com:12879"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_MECHANISM="SCRAM-SHA-256"
KAFKA_SASL_USERNAME="avnadmin"
KAFKA_SASL_PASSWORD="your-aiven-kafka-password"
KAFKA_TOPIC_LAB_EVENTS="ckd.lab.events"
KAFKA_TOPIC_ALERTS="ckd.critical.alerts"

